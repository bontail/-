# Карты (123). Каждая строка переносит тип, название, стоимость,
# редкость, цели, принадлежность к колодам и прямые контры из Prolog.

:archer_queen a :Troop, :GroundTroop ; rdfs:label "Королева лучниц"@ru ; :elixirCost 5 ; :hasRarity :champion ; :hasTargets :air_ground .
:archers a :Troop, :GroundTroop ; rdfs:label "Лучницы"@ru ; :elixirCost 3 ; :hasRarity :common ; :hasTargets :air_ground ; :inDeck :mortar_cycle, :xbow_siege .
:arrows a :Spell, :AreaDamageCard ; rdfs:label "Стрелы"@ru ; :elixirCost 3 ; :hasRarity :common ; :hasTargets :air_ground ; :inDeck :golem_beatdown, :minion_giant_balloon ; :counters :archers, :bats, :dart_goblin, :firecracker, :goblin_barrel, :goblin_gang, :minion_horde, :minions, :princess, :skeleton_army, :skeleton_barrel, :suspicious_bush, :wall_breakers .
:baby_dragon a :Troop, :FlyingTroop, :AreaDamageCard ; rdfs:label "Дракончик"@ru ; :elixirCost 4 ; :hasRarity :epic ; :hasTargets :air_ground ; :inDeck :egiant_lightning, :golem_beatdown, :minion_giant_balloon, :splashyard ; :counters :bats, :elixir_golem .
:balloon a :Troop, :FlyingTroop, :WinCondition ; rdfs:label "Шар"@ru ; :elixirCost 5 ; :hasRarity :epic ; :hasTargets :buildings ; :inDeck :balloon_freeze, :lavaloon, :minion_giant_balloon .
:bandit a :Troop, :GroundTroop ; rdfs:label "Бандитка"@ru ; :elixirCost 3 ; :hasRarity :legendary ; :hasTargets :ground ; :inDeck :bridge_spam_deck, :mega_knight_control, :ram_rider_bridge_spam, :three_musketeers .
:barbarian_barrel a :Spell, :AreaDamageCard ; rdfs:label "Варварская бочка"@ru ; :elixirCost 2 ; :hasRarity :epic ; :hasTargets :ground ; :inDeck :balloon_freeze, :egiant_lightning, :splashyard ; :counters :goblins .
:barbarian_hut a :Building ; rdfs:label "Хижина варваров"@ru ; :elixirCost 6 ; :hasRarity :rare ; :hasTargets :ground .
:barbarians a :Troop, :GroundTroop, :SwarmTroop ; rdfs:label "Варвары"@ru ; :elixirCost 5 ; :hasRarity :common ; :hasTargets :ground .
:bats a :Troop, :FlyingTroop, :SwarmTroop ; rdfs:label "Летучие мыши"@ru ; :elixirCost 2 ; :hasRarity :common ; :hasTargets :air_ground ; :inDeck :balloon_freeze, :giant_double_prince, :mega_knight_control, :miner_poison ; :counters :balloon .
:battle_healer a :Troop, :GroundTroop ; rdfs:label "Целительница-воин"@ru ; :elixirCost 4 ; :hasRarity :rare ; :hasTargets :ground .
:battle_ram a :Troop, :GroundTroop, :WinCondition ; rdfs:label "Боевой таран"@ru ; :elixirCost 4 ; :hasRarity :rare ; :hasTargets :buildings ; :inDeck :bridge_spam_deck, :three_musketeers .
:berserker a :Troop, :GroundTroop ; rdfs:label "Берсеркша"@ru ; :elixirCost 2 ; :hasRarity :common ; :hasTargets :ground .
:bomb_tower a :Building, :AreaDamageCard ; rdfs:label "Башня-бомбежка"@ru ; :elixirCost 4 ; :hasRarity :rare ; :hasTargets :ground ; :counters :hog_rider, :royal_hogs .
:bomber a :Troop, :GroundTroop, :AreaDamageCard ; rdfs:label "Подрывник"@ru ; :elixirCost 2 ; :hasRarity :common ; :hasTargets :ground ; :counters :barbarians, :goblin_gang, :skeleton_army .
:boss_bandit a :Troop, :GroundTroop ; rdfs:label "Главная бандитка"@ru ; :elixirCost 6 ; :hasRarity :champion ; :hasTargets :ground .
:bowler a :Troop, :GroundTroop, :AreaDamageCard ; rdfs:label "Вышибала"@ru ; :elixirCost 5 ; :hasRarity :epic ; :hasTargets :ground ; :counters :barbarians, :graveyard, :royal_hogs, :royal_recruits .
:cannon a :Building ; rdfs:label "Пушка"@ru ; :elixirCost 3 ; :hasRarity :common ; :hasTargets :ground ; :inDeck :hog_cycle ; :counters :hog_rider .
