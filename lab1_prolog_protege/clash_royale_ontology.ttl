@prefix : <http://example.org/clash-royale#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .

<http://example.org/clash-royale> a owl:Ontology ;
    rdfs:label "Clash Royale"@ru ;
    rdfs:comment "Перенос базы знаний из clash_royale.pl."@ru .


# Классы из одноместных предикатов Prolog

:Card a owl:Class ; rdfs:label "Карта"@ru .

:Troop a owl:Class ; rdfs:subClassOf :Card ; rdfs:label "Войско"@ru .

:Spell a owl:Class ; rdfs:subClassOf :Card ; rdfs:label "Заклинание"@ru .

:Building a owl:Class ; rdfs:subClassOf :Card ; rdfs:label "Здание"@ru .

:FlyingTroop a owl:Class ; rdfs:subClassOf :Troop ; rdfs:label "Летающее войско"@ru .

:GroundTroop a owl:Class ; rdfs:subClassOf :Troop ; rdfs:label "Наземное войско"@ru .

:SwarmCard a owl:Class ; rdfs:subClassOf :Card ; rdfs:label "Карта-рой"@ru .

:SwarmTroop a owl:Class ; rdfs:subClassOf :SwarmCard ; rdfs:label "Рой (войско)"@ru .

:AreaDamageCard a owl:Class ; rdfs:subClassOf :Card ; rdfs:label "Урон по площади"@ru .

:WinCondition a owl:Class ; rdfs:subClassOf :Card ; rdfs:label "Ударная карта"@ru .

:Deck a owl:Class ; rdfs:label "Колода"@ru .

:Rarity a owl:Class ; rdfs:label "Редкость"@ru .

:TargetType a owl:Class ; rdfs:label "Тип цели"@ru .

:Archetype a owl:Class ; rdfs:label "Архетип"@ru .


[] a owl:AllDisjointClasses ; owl:members ( :Troop :Spell :Building ) .

:FlyingTroop owl:disjointWith :GroundTroop .


# Свойства из двухместных предикатов Prolog

:hasRarity a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain :Card ; rdfs:range :Rarity ; rdfs:label "имеет редкость"@ru .


:hasTargets a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain :Card ; rdfs:range :TargetType ; rdfs:label "атакует цели"@ru .


:counters a owl:ObjectProperty ;
    rdfs:domain :Card ; rdfs:range :Card ; rdfs:label "контрит"@ru .


:inDeck a owl:ObjectProperty ;
    rdfs:domain :Card ; rdfs:range :Deck ; rdfs:label "входит в колоду"@ru .


:hasCard a owl:ObjectProperty ;
    owl:inverseOf :inDeck ; rdfs:label "содержит карту"@ru .


:hasArchetype a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain :Deck ; rdfs:range :Archetype ; rdfs:label "имеет архетип"@ru .


:elixirCost a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain :Card ; rdfs:range xsd:integer ; rdfs:label "стоимость в эликсире"@ru .


:minTrophies a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain :Rarity ; rdfs:range xsd:integer ; rdfs:label "минимум кубков"@ru .


# Свойства, соответствующие правилам can_hit, good_against и synergy

:canHit a owl:ObjectProperty ;
    rdfs:domain :Card ; rdfs:range :Troop ; rdfs:label "может атаковать"@ru .


:goodAgainst a owl:ObjectProperty ;
    rdfs:domain :Card ; rdfs:range :Card ; rdfs:label "хорош против"@ru .


:counters rdfs:subPropertyOf :goodAgainst .


:synergy a owl:ObjectProperty, owl:SymmetricProperty ;
    owl:propertyChainAxiom ( :inDeck :hasCard ) ;
    rdfs:label "сочетается с"@ru .


# Классы, соответствующие правилам anti_air и cost_category

:AntiAirCard a owl:Class ;
    rdfs:subClassOf :Card ;
    rdfs:label "Карта против воздуха"@ru ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :Card
            [ a owl:Restriction ; owl:onProperty :hasTargets ; owl:hasValue :air_ground ]
        )
    ] .


:CheapCard a owl:Class ;
    rdfs:subClassOf :Card ; rdfs:label "Дешёвая карта"@ru ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :Card
            [ a owl:Restriction ; owl:onProperty :elixirCost ;
              owl:someValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:integer ;
                  owl:withRestrictions ( [ xsd:maxInclusive 2 ] ) ] ]
        )
    ] .


:MediumCostCard a owl:Class ;
    rdfs:subClassOf :Card ; rdfs:label "Карта средней стоимости"@ru ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :Card
            [ a owl:Restriction ; owl:onProperty :elixirCost ;
              owl:someValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:integer ;
                  owl:withRestrictions ( [ xsd:minInclusive 3 ] [ xsd:maxInclusive 4 ] ) ] ]
        )
    ] .


:HeavyCard a owl:Class ;
    rdfs:subClassOf :Card ; rdfs:label "Дорогая карта"@ru ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :Card
            [ a owl:Restriction ; owl:onProperty :elixirCost ;
              owl:someValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:integer ;
                  owl:withRestrictions ( [ xsd:minInclusive 5 ] ) ] ]
        )
    ] .


# Карты, которые не атакуют только здания. Используется в правиле canHit.
:GeneralAttacker a owl:Class ;
    rdfs:subClassOf :Card ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :Card [ a owl:Class ; owl:unionOf (
            [ a owl:Restriction ; owl:onProperty :hasTargets ; owl:hasValue :ground ]
            [ a owl:Restriction ; owl:onProperty :hasTargets ; owl:hasValue :air_ground ]
        ) ] )
    ] .


:BuildingTargeter a owl:Class ;
    rdfs:subClassOf :Troop ;
    rdfs:label "Бьёт только здания"@ru ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Troop
        [ a owl:Restriction ; owl:onProperty :hasTargets ; owl:hasValue :buildings ] ) ] .


:CounterCard a owl:Class ;
    rdfs:subClassOf :Card ; rdfs:label "Контра"@ru ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Card
        [ a owl:Restriction ; owl:onProperty :counters ; owl:someValuesFrom :Card ] ) ] .


:LegendaryCard a owl:Class ;
    rdfs:subClassOf :Card ; rdfs:label "Легендарная карта"@ru ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Card
        [ a owl:Restriction ; owl:onProperty :hasRarity ; owl:hasValue :legendary ] ) ] .


:ChampionCard a owl:Class ;
    rdfs:subClassOf :Card ; rdfs:label "Карта-чемпион"@ru ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Card
        [ a owl:Restriction ; owl:onProperty :hasRarity ; owl:hasValue :champion ] ) ] .


:BeginnerFriendlyCard a owl:Class ;
    rdfs:subClassOf :Card ; rdfs:label "Карта для новичка"@ru ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Card
        [ a owl:Restriction ; owl:onProperty :hasRarity ; owl:someValuesFrom
            [ a owl:Class ; owl:intersectionOf ( :Rarity
                [ a owl:Restriction ; owl:onProperty :minTrophies ; owl:someValuesFrom
                    [ a rdfs:Datatype ; owl:onDatatype xsd:integer ;
                      owl:withRestrictions ( [ xsd:maxInclusive 0 ] ) ] ] ) ] ] ) ] .


:CycleDeck a owl:Class ;
    rdfs:subClassOf :Deck ; rdfs:label "Колода-цикл"@ru ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Deck
        [ a owl:Restriction ; owl:onProperty :hasArchetype ; owl:hasValue :cycle ] ) ] .


:BaitDeck a owl:Class ;
    rdfs:subClassOf :Deck ; rdfs:label "Бейт-колода"@ru ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Deck
        [ a owl:Restriction ; owl:onProperty :hasArchetype ; owl:hasValue :bait ] ) ] .


:BeatdownDeck a owl:Class ;
    rdfs:subClassOf :Deck ; rdfs:label "Битдаун-колода"@ru ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Deck
        [ a owl:Restriction ; owl:onProperty :hasArchetype ; owl:hasValue :beatdown ] ) ] .


:SiegeDeck a owl:Class ;
    rdfs:subClassOf :Deck ; rdfs:label "Осадная колода"@ru ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Deck
        [ a owl:Restriction ; owl:onProperty :hasArchetype ; owl:hasValue :siege ] ) ] .


:BridgeSpamDeck a owl:Class ;
    rdfs:subClassOf :Deck ; rdfs:label "Бридж-спам колода"@ru ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Deck
        [ a owl:Restriction ; owl:onProperty :hasArchetype ; owl:hasValue :bridge_spam ] ) ] .


:ControlDeck a owl:Class ;
    rdfs:subClassOf :Deck ; rdfs:label "Контроль-колода"@ru ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Deck
        [ a owl:Restriction ; owl:onProperty :hasArchetype ; owl:hasValue :control ] ) ] .


:DeckWithBuilding a owl:Class ;
    rdfs:subClassOf :Deck ; rdfs:label "Колода со зданием"@ru ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Deck
        [ a owl:Restriction ; owl:onProperty :hasCard ; owl:someValuesFrom :Building ] ) ] .



:NonAreaDamageCard a owl:Class ;
    rdfs:subClassOf :Card ; rdfs:label "Без урона по площади"@ru ;
    owl:equivalentClass [ owl:complementOf :AreaDamageCard ] .


:NonSwarmCard a owl:Class ;
    rdfs:subClassOf :Card ; rdfs:label "Не рой"@ru ;
    owl:equivalentClass [ owl:complementOf :SwarmCard ] .


:NonAntiAirCard a owl:Class ;
    rdfs:subClassOf :Card ; rdfs:label "Не бьёт по воздуху"@ru ;
    owl:equivalentClass [ owl:complementOf :AntiAirCard ] .


:TroopOrBuilding a owl:Class ;
    rdfs:label "Войско или здание"@ru ;
    owl:equivalentClass [ owl:unionOf ( :Troop :Building ) ] .


:AirAttackDeck a owl:Class ;
    rdfs:subClassOf :Deck ; rdfs:label "Колода с воздушной атакой"@ru ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Deck
        [ a owl:Restriction ; owl:onProperty :hasCard ; owl:someValuesFrom
            [ a owl:Class ; owl:intersectionOf ( :FlyingTroop :WinCondition ) ] ] ) ] .


# SWRL: AntiAirCard(A) и FlyingTroop(T) -> canHit(A,T).
:attacker a swrl:Variable .

:target a swrl:Variable .

:enemy a swrl:Variable .


:CanHitFlyingRule a swrl:Imp ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate :AntiAirCard ; swrl:argument1 :attacker ]
        [ a swrl:ClassAtom ; swrl:classPredicate :FlyingTroop ; swrl:argument1 :target ]
    ) ;
    swrl:head (
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :canHit ;
          swrl:argument1 :attacker ; swrl:argument2 :target ]
    ) .


# SWRL: GeneralAttacker(A) и GroundTroop(T) -> canHit(A,T).
:CanHitGroundRule a swrl:Imp ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate :GeneralAttacker ; swrl:argument1 :attacker ]
        [ a swrl:ClassAtom ; swrl:classPredicate :GroundTroop ; swrl:argument1 :target ]
    ) ;
    swrl:head (
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :canHit ;
          swrl:argument1 :attacker ; swrl:argument2 :target ]
    ) .


# SWRL: AreaDamageCard(A), SwarmCard(E), canHit(A,E) -> goodAgainst(A,E).
:GoodAgainstSwarmRule a swrl:Imp ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate :AreaDamageCard ; swrl:argument1 :attacker ]
        [ a swrl:ClassAtom ; swrl:classPredicate :SwarmCard ; swrl:argument1 :enemy ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :canHit ;
          swrl:argument1 :attacker ; swrl:argument2 :enemy ]
    ) ;
    swrl:head (
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :goodAgainst ;
          swrl:argument1 :attacker ; swrl:argument2 :enemy ]
    ) .


# SWRL: рой(A), карта(E) без урона по площади, не рой и не бьёт только
# здания, стоимость >= 4 -> goodAgainst(A,E).
:GoodAgainstExpensiveRule a swrl:Imp ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate :SwarmTroop ; swrl:argument1 :attacker ]
        [ a swrl:ClassAtom ; swrl:classPredicate :NonAreaDamageCard ; swrl:argument1 :enemy ]
        [ a swrl:ClassAtom ; swrl:classPredicate :NonSwarmCard ; swrl:argument1 :enemy ]
        [ a swrl:ClassAtom ; swrl:classPredicate [ owl:complementOf :BuildingTargeter ] ;
          swrl:argument1 :enemy ]
        [ a swrl:DataPropertyAtom ; swrl:propertyPredicate :elixirCost ;
          swrl:argument1 :enemy ; swrl:argument2 :cost ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ;
          swrl:arguments ( :cost 4 ) ]
    ) ;
    swrl:head (
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :goodAgainst ;
          swrl:argument1 :attacker ; swrl:argument2 :enemy ]
    ) .


# SWRL: летающая карта без целей «только здания» против войска или здания,
# которое не бьёт по воздуху -> goodAgainst(A,E).
:GoodAgainstGroundRule a swrl:Imp ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate :FlyingTroop ; swrl:argument1 :attacker ]
        [ a swrl:ClassAtom ; swrl:classPredicate [ owl:complementOf :BuildingTargeter ] ;
          swrl:argument1 :attacker ]
        [ a swrl:ClassAtom ; swrl:classPredicate :TroopOrBuilding ; swrl:argument1 :enemy ]
        [ a swrl:ClassAtom ; swrl:classPredicate :NonAntiAirCard ; swrl:argument1 :enemy ]
        [ a swrl:ClassAtom ; swrl:classPredicate [ owl:complementOf :BuildingTargeter ] ;
          swrl:argument1 :enemy ]
    ) ;
    swrl:head (
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :goodAgainst ;
          swrl:argument1 :attacker ; swrl:argument2 :enemy ]
    ) .

# Значения редкости, типов целей и архетипов

# rarity_min_trophies/2 из Prolog
:common a :Rarity ; :minTrophies 0 .
:rare a :Rarity ; :minTrophies 0 .
:epic a :Rarity ; :minTrophies 1000 .
:legendary a :Rarity ; :minTrophies 3000 .
:champion a :Rarity ; :minTrophies 5000 .

:ground a :TargetType .
:air_ground a :TargetType .
:buildings a :TargetType .

:cycle a :Archetype ; rdfs:label "быстрый цикл"@ru .
:bait a :Archetype ; rdfs:label "бейт (приманка)"@ru .
:beatdown a :Archetype ; rdfs:label "битдаун (мощный пуш)"@ru .
:siege a :Archetype ; rdfs:label "осада"@ru .
:bridge_spam a :Archetype ; rdfs:label "бридж-спам"@ru .
:control a :Archetype ; rdfs:label "контроль"@ru .

[] a owl:AllDifferent ;
    owl:distinctMembers ( :common :rare :epic :legendary :champion :ground :air_ground :buildings :cycle :bait :beatdown :siege :bridge_spam :control ) .

# Колоды (19): deck/1, deck_name/2, archetype/2 из Prolog.

:hog_cycle a :Deck ;
    rdfs:label "Хог-цикл 2.6"@ru ;
    :hasArchetype :cycle .

:royal_hogs_cycle a :Deck ;
    rdfs:label "Королевские кабаны 3.0"@ru ;
    :hasArchetype :cycle .

:mortar_cycle a :Deck ;
    rdfs:label "Мортира 3.0"@ru ;
    :hasArchetype :siege .

