    :hasArchetype :control .

:goblinstein_control a :Deck ;
    rdfs:label "Гоблинштейн-контроль"@ru ;
    :hasArchetype :control .

:three_musketeers a :Deck ;
    rdfs:label "Три мушкетёра"@ru ;
