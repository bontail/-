    rdfs:label "Осада с Арбалетом"@ru ;
    :hasArchetype :siege .

:log_bait a :Deck ;
    rdfs:label "Лог-бейт"@ru ;
    :hasArchetype :bait .

:goblin_bait a :Deck ;
